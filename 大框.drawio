        <mxCell id="xvR7rRsYKM5JVGg1SIH_-34" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="C文件" vertex="1">
